# Environment Configuration Template
# Copy this file to .env and fill in your values

# Unitree L2 LiDAR Settings
LIDAR_IP_ADDRESS=192.168.1.1
LIDAR_PORT=2368

# Data Storage Paths
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# AWS Settings (for Phase 2 - Cloud Storage)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=trail-maps

# Database Settings (for Phase 2 - Backend)
# DATABASE_URL=postgresql://user:password@localhost:5432/trail_maps
# MONGODB_URI=mongodb://localhost:27017/trail_maps

# API Settings (for Phase 2 - Backend)
# API_HOST=0.0.0.0
# API_PORT=5000
# API_DEBUG=False

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/lidar_system.log